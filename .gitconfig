[init]
    defaultBranch = main

[core]
    safecrlf = warn
    # editor = 'C:/Program Files/Notepad++/notepad++.exe' -multiInst -notabbar -nosession -noPlugin
    editor = code --wait
    fscache = true
    fsmonitor = true
    excludesfile = ~/.gitignore_global
    symlinks = true
    longpaths = true

[color]
    diff = auto
    status = auto
    branch = auto
    interactive = auto
    ui = auto

[color "branch"]
    current = green bold
    local = green
    remote = red bold

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[branch]
    # autosetupmerge = always
    autosetuprebase = never

[fetch]
  prune = true

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[rebase]
    autostash = true

[submodule]
    fetchjobs = 8

[credential]
    helper = manager
    credentialStore = dpapi

    allowWindowsAuth = true
    msauthUseBroker = true
    msauthUseDefaultAccount = true

    azreposCredentialType = oauth

[diff]
    renames = copies
    # mnemonicprefix = true
    compactionHeuristic = true
    # tool = vscode

[difftool]
    prompt = false
    trustExitCode = true
    keepBackup = false

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

[merge]
    # tool = vscode

[mergetool]
    prompt = false
    trustExitCode = true
    keepBackup = false

[mergetool "vscode"]
  cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[alias]
    # add
	a  = add
    aa = add --all
    unstage = reset HEAD --

    # branch
	b  = branch
	bd  = branch -D
    br = for-each-ref --sort=-committerdate --format=\"%(color:yellow)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
    brl = branch --sort=-committerdate --format='%(color:yellow)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)'
    bprune = "!f() { \
        delete_flag=-d; dry_run=false; \
        for arg in \"$@\"; do \
            case \"$arg\" in \
                --force|-f) delete_flag=-D ;; \
                --dry-run|-n) dry_run=true ;; \
                --help|-h) echo 'Usage: git bprune [--dry-run] [--force]'; return 0 ;; \
                *) echo \"Unknown option: $arg\" >&2; return 2 ;; \
            esac; \
        done; \
        git rev-parse --git-dir >/dev/null || return; \
        default_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD); \
        default_branch=${default_ref#refs/remotes/origin/}; \
        if [ -z \"$default_branch\" ] && git remote get-url origin >/dev/null 2>&1; then \
            remote_head=$(git ls-remote --symref origin HEAD) || return; \
            default_branch=$(printf '%s\\n' \"$remote_head\" | sed -n 's|^ref: refs/heads/\\(.*\\)[[:space:]]HEAD$|\\1|p'); \
            if [ -z \"$default_branch\" ]; then \
                echo 'Cannot determine the default branch on origin. No branches were deleted.' >&2; return 1; \
            fi; \
        fi; \
        branches=$(git for-each-ref --format='%(refname:strip=2) %(worktreepath)' refs/heads) || return; \
        printf '%s\\n' \"$branches\" | { \
            result=0; found=false; \
            while IFS=' ' read -r branch worktree; do \
                [ -n \"$branch\" ] || continue; \
                [ -z \"$worktree\" ] || continue; \
                case \"$branch\" in main|master) continue ;; esac; \
                [ \"$branch\" != \"$default_branch\" ] || continue; \
                found=true; \
                if [ \"$dry_run\" = true ]; then \
                    printf 'Would try git branch %s -- %s\\n' \"$delete_flag\" \"$branch\"; \
                else \
                    git branch \"$delete_flag\" -- \"$branch\" || result=1; \
                fi; \
            done; \
            [ \"$found\" = true ] || echo 'No unused local branches to prune.'; \
            return \"$result\"; \
        }; \
    }; f"
    del = branch -D


    # checkout
    co = checkout
    cob = checkout -b

    # switch
    sw   = switch

    # push
    p = push
    pa = push --all
    pt = push --tags
    done = push origin HEAD

    # pull
    up = !git pull --rebase --prune $@ && git submodule update --init --recursive

    # fetch
    f = fetch --prune --all --tags

    # commit
    c = commit
    cs = commit -S
    cm = commit -m
    cma = commit -a -m
    c- = commit --amend
    # c+ = commit --amend --reuse-message HEAD
    camend = commit --amend --reuse-message HEAD
    cempty = commit --allow-empty
	missing = "!f() { git cherry ${1} ${2} --verbose --abbrev=10 | grep "+ "; }; f"

    cl = clean -df
    cl-all = clean -xdf -e .vscode
    undo = reset HEAD~1 --mixed
    res = !git reset --hard

    # log
    s = status --short --branch
    lg = !git log --pretty=format:\"%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- [%an]%C(reset)%C(bold yellow)%d%C(reset)\" --abbrev-commit -30
    last = log -1 HEAD --stat
    lch = log -n 1 --pretty=format:'%H'
    contrib = shortlog -e --summary --numbered
    contribLoC = "!git ls-files | xargs -n1 git blame --line-porcelain | sed -n 's/^author //p' | sort -f | uniq -ic | sort -nr"

    # diff
    cdiff = difftool --tool code
    diffdir = difftool --dir-diff --tool code

    # worktree
    wt = worktree
    wtl = worktree list
    wtadd = worktree add
    wtdel = worktree remove
    wtprune = worktree prune

    # config
    root = rev-parse --show-toplevel
    al = config --get-regexp alias
    whoami = "!git config user.name && git config user.email"

[url "git@github.com:"]
    insteadof = github:

[credential "https://dev.azure.com"]
	useHttpPath = true

[include]
    # A local gitconfig, outside of version control.
    # If the file doesn't exist it is silently ignored
    path = ~/.gitconfig-local

